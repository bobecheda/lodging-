# drift_dev compares schema snapshots as raw text against what it generates
# (LF). Keep them LF on Windows checkouts too, or make-migrations reports a
# spurious "schema differs".
lodging_pos/drift_schemas/** text eol=lf

# drift copies trigger SQL text, line endings included, into the schema
# snapshots, and the v1-v4 snapshots were made from a Windows (CRLF)
# checkout. Check .drift files out as CRLF on every OS, so Linux CI produces
# byte-identical snapshots. Don't change this without regenerating and
# reviewing all snapshots. (Stored in the repo as LF, as before.)
lodging_pos/**/*.drift text eol=crlf

# Fonts are binary; never touch their line endings.
*.ttf binary

# Flutter regenerates the Windows plugin registrant with LF endings on every
# build, so a CRLF checkout (core.autocrlf) shows them as changed. Keep them
# LF on Windows checkouts too.
lodging_pos/windows/flutter/generated_* text eol=lf
