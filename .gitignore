# Secrets never enter the repo. Keys (e.g. Supabase, sprint 2) are passed at
# build time with --dart-define-from-file from an untracked file; see
# lodging_pos/CLAUDE.md. These patterns match at any depth.
.env
*.env
secrets*.json

# The Android upload key and its passwords (lodging_pos/docs/release.md).
key.properties
*.jks
*.keystore

# Editor settings are per machine.
.vscode/
