-- Database-level guards for the single write path (see CLAUDE.md).
--
-- Every UPDATE of a synced table must move updated_at, which only
-- writeWithAudit does; a direct update would skip audit_log and outbox.
-- Stays, payments, charges and voids are never deleted (BR-11), and
-- audit_log is append-only.
import 'tables/admin_tables.dart';
import 'tables/desk_tables.dart';
import 'tables/setup_tables.dart';
import 'tables/system_tables.dart';

CREATE TRIGGER users_stamped_update BEFORE UPDATE ON users
  WHEN NEW.updated_at IS OLD.updated_at
  BEGIN SELECT RAISE(ABORT, 'must be stamped by writeWithAudit'); END;

CREATE TRIGGER settings_stamped_update BEFORE UPDATE ON settings
  WHEN NEW.updated_at IS OLD.updated_at
  BEGIN SELECT RAISE(ABORT, 'must be stamped by writeWithAudit'); END;

CREATE TRIGGER bed_categories_stamped_update BEFORE UPDATE ON bed_categories
  WHEN NEW.updated_at IS OLD.updated_at
  BEGIN SELECT RAISE(ABORT, 'must be stamped by writeWithAudit'); END;

CREATE TRIGGER rooms_stamped_update BEFORE UPDATE ON rooms
  WHEN NEW.updated_at IS OLD.updated_at
  BEGIN SELECT RAISE(ABORT, 'must be stamped by writeWithAudit'); END;

CREATE TRIGGER beds_stamped_update BEFORE UPDATE ON beds
  WHEN NEW.updated_at IS OLD.updated_at
  BEGIN SELECT RAISE(ABORT, 'must be stamped by writeWithAudit'); END;

CREATE TRIGGER housekeepers_stamped_update BEFORE UPDATE ON housekeepers
  WHEN NEW.updated_at IS OLD.updated_at
  BEGIN SELECT RAISE(ABORT, 'must be stamped by writeWithAudit'); END;

CREATE TRIGGER guests_stamped_update BEFORE UPDATE ON guests
  WHEN NEW.updated_at IS OLD.updated_at
  BEGIN SELECT RAISE(ABORT, 'must be stamped by writeWithAudit'); END;

